{
  "commands": {
    "build": "make build",
    "coverage": "make docker-test",
    "lint": "make lint",
    "security_vulns": [
      {
        "cmd": [
          "pip-audit"
        ],
        "requires": "pyproject.toml"
      },
      {
        "cmd": [
          "npm",
          "audit",
          "--audit-level=high"
        ],
        "requires": "package.json"
      }
    ],
    "tests": "make docker-test",
    "types": "make typecheck"
  },
  "description": "Quality gate configuration for Python project",
  "thresholds": {
    "build": {
      "operator": "=",
      "type": "exit_code",
      "value": 0
    },
    "coverage": {
      "operator": "\u2265",
      "type": "percentage",
      "value": 85
    },
    "lint": {
      "operator": "=",
      "type": "count",
      "value": 0
    },
    "security_secrets": {
      "operator": "\u2264",
      "type": "count"
    },
    "security_vulns": {
      "operator": "\u2264",
      "type": "count"
    },
    "tests": {
      "operator": "\u2265",
      "type": "count"
    },
    "types": {
      "operator": "\u2264",
      "type": "count"
    }
  }
}
