# Root directory to scan for guideline violations
SCAN_ROOT=.

# Central server: directory where pushed per-repo reports are stored
CENTRAL_STORE=./central-store

# Set to false to bypass X-API-Key checks in local dev (NEVER disable in production)
AUTH_ENABLED=true
# Auth mode: disabled | api_key | local | ldap | oidc
AUTH_MODE=api_key
# API key for programmatic access to /api/* endpoints
API_KEY=
# Local mode credentials
LOCAL_USERNAME=
LOCAL_PASSWORD=
# LDAP settings (only required when AUTH_MODE=ldap)
LDAP_URL=ldap://localhost
LDAP_USER_DN_TEMPLATE=uid={username},dc=example,dc=com
# OIDC settings (only required when AUTH_MODE=oidc)
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
